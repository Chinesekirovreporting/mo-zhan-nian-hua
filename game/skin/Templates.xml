	<Frame name="MZPageTemplate" virtual="true" hidden="true">
		<Anchors>
			<Anchor point="TOPLEFT" x="20" y="-18"/>
			<Anchor point="BOTTOMRIGHT" x="-20" y="18"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentTitle" inherits="GameFontNormal" justifyH="LEFT">
					<FontHeight>
						<AbsValue val="15"/>
					</FontHeight>
					<Color r="0.106" g="0.098" b="0.086"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</FontString>
				<FontString name="$parentSubtitle" inherits="GameFontHighlight" justifyH="LEFT">
					<Color r="0.435" g="0.408" b="0.361"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentTitle" relativePoint="BOTTOMLEFT" x="0" y="-5"/>
						<Anchor point="RIGHT" x="0" y="0"/>
					</Anchors>
				</FontString>
				<Texture name="$parentRule" file="Interface\ChatFrame\ChatFrameBackground">
					<Size y="1"/>
					<Anchors>
						<Anchor point="TOPLEFT" y="-48"/>
						<Anchor point="TOPRIGHT" y="-48"/>
					</Anchors>
					<Color r="0.106" g="0.098" b="0.086" a="0.35"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentBody">
				<Anchors>
					<Anchor point="TOPLEFT" y="-62"/>
					<Anchor point="BOTTOMRIGHT"/>
				</Anchors>
			</Frame>
		</Frames>
