					<Color r="0.106" g="0.098" b="0.086"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="14" y="-12"/>
						<Anchor point="RIGHT" x="-108" y="0"/>
					</Anchors>
				</FontString>
				<FontString name="$parentDesc" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
					<Color r="0.435" g="0.408" b="0.361"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentTitle" relativePoint="BOTTOMLEFT" x="0" y="-6"/>
						<Anchor point="RIGHT" x="-108" y="0"/>
