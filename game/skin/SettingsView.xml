<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">
	<!-- 子窗口：设置。缩放与重置在 game/view/views/SettingsView.lua。 -->
	<Frame name="MZPageSettings" parent="MZMainContent" inherits="MZPageTemplate" hidden="true"/>

	<Frame name="MZSettingsChrome" parent="MZPageSettings">
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="MZPageSettingsBody"/>
			<Anchor point="BOTTOMRIGHT" relativeTo="MZPageSettingsBody"/>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="MZSettingsAbout" inherits="GameFontHighlight" justifyH="LEFT" text="">
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="-88"/>
					</Anchors>
					<Color r="0.435" g="0.408" b="0.361"/>
				</FontString>
				<FontString name="MZSettingsUsage" inherits="GameFontHighlight" justifyH="LEFT" text="命令：/mznh 或 /mz 打开面板　/mz reset 重置　/mz test 查看状态">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="MZSettingsAbout" relativePoint="BOTTOMLEFT" x="0" y="-6"/>
					</Anchors>
					<Color r="0.435" g="0.408" b="0.361"/>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="MZSettingsScaleLabel">
				<Size x="70" y="26"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="2" y="-6"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString name="$parentText" inherits="GameFontHighlight" text="面板缩放" justifyH="LEFT">
							<Anchors>
								<Anchor point="LEFT"/>
							</Anchors>
							<Color r="0.278" g="0.259" b="0.227"/>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
			<Button name="MZSettingsMinus" inherits="MZButtonTemplate" text="－">
				<Size x="30" y="26"/>
				<Anchors>
					<Anchor point="LEFT" relativeTo="MZSettingsScaleLabel" relativePoint="RIGHT" x="14" y="0"/>
				</Anchors>
			</Button>
			<Frame name="MZSettingsPercent">
				<Size x="48" y="26"/>
				<Anchors>
					<Anchor point="LEFT" relativeTo="MZSettingsMinus" relativePoint="RIGHT" x="10" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<FontString name="$parentText" inherits="GameFontHighlight" justifyH="LEFT" text="100%">
							<Anchors>
								<Anchor point="LEFT"/>
							</Anchors>
							<Color r="0.106" g="0.098" b="0.086"/>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
			<Button name="MZSettingsPlus" inherits="MZButtonTemplate" text="＋">
				<Size x="30" y="26"/>
				<Anchors>
					<Anchor point="LEFT" relativeTo="MZSettingsPercent" relativePoint="RIGHT" x="10" y="0"/>
				</Anchors>
			</Button>
			<Button name="MZSettingsReset" inherits="MZButtonTemplate" text="重置位置与缩放">
				<Size x="132" y="26"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="2" y="-44"/>
				</Anchors>
			</Button>
		</Frames>
	</Frame>
</Ui>
